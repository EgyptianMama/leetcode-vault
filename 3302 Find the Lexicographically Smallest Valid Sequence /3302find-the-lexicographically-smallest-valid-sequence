class Solution {
    public int[] validSequence(String word1, String word2) {
        int m = word1.length();
        int n = word2.length();

        int[] suffix = new int[n];
        Arrays.fill(suffix, -1);

        int i = m - 1;
        for (int j = n - 1; j >= 0; j--) {
            while (i >= 0 && word1.charAt(i) != word2.charAt(j)) {
                i--;
            }

            if (i >= 0) {
                suffix[j] = i;
                i--;
            }
        }

        int[] ans = new int[n];

        i = 0;
        int j = 0;
        boolean changed = false;

        while (i < m && j < n) {
            if (word1.charAt(i) == word2.charAt(j)) {
                ans[j] = i;
                i++;
                j++;
            }
            else if (!changed &&
                    (j == n - 1 ||
                     (suffix[j + 1] != -1 && i < suffix[j + 1]))) {

                ans[j] = i;
                changed = true;
                i++;
                j++;
            }

            else {
                i++;
            }
        }

        return j == n ? ans : new int[0];
    }
}
